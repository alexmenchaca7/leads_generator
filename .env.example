# Copy this file to .env and fill in your Supabase credentials.
# Supabase → Project Settings → API
#
#   SUPABASE_URL         = "Project URL"
#   SUPABASE_SERVICE_KEY = "service_role" key  (keep this secret — server-only)
#
# These are only needed for the optional cloud sync feature.
# The scraper works without them using Excel alone.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
