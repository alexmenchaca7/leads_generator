# Copia como  .env.local  y rellena con los datos de tu proyecto Supabase.
# Supabase -> Project Settings -> API
#   NEXT_PUBLIC_SUPABASE_URL       = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = "anon / public" key  (NO la service_role)
#   SUPABASE_SERVICE_ROLE_KEY      = "service_role" key   (SECRETA, solo servidor)
#
# Las tres se configuran igual en Vercel (Project -> Settings -> Environment Variables).
#
# La service_role NO lleva el prefijo NEXT_PUBLIC_ a proposito: nunca debe llegar
# al navegador. La usan solo las rutas de servidor:
#   /api/admin/users   -> alta/baja de usuarios y reseteo de contrasenas
#   /api/worker-env    -> genera el archivo conexion.env del motor de busquedas
# Sin ella el dashboard funciona, pero esas dos pantallas fallan.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
